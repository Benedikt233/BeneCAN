# ---------------------------------------------------------------- 运行产物
# 日志（V0.1 起程序会写到程序同级的 logs/）
logs/
*.log
# PyInstaller 产物（exe 体积大，不入库）
dist/
build/

# ---------------------------------------------------------------- 缓存/编译
__pycache__/
*.py[cod]
# ASC 索引（可随时重建）
*.parquet

# ---------------------------------------------------------------- 测试样本
# 真实 ASC 样本（单份 500 MB+，不入库）
TestZone/

# ---------------------------------------------------------------- DBC
# 真实 DBC 待信息安全评估，不入库；只保留随包分发的自造示例
dbc/*.dbc
!dbc/example.dbc
# 通道映射是本机配置，不随仓库分发
dbc/channel_map.json

# ---------------------------------------------------------------- 编辑器/系统
.vscode/
.idea/
Thumbs.db
desktop.ini
*.tmp
